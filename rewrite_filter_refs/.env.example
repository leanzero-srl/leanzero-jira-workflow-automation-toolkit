# Jira Cloud
CLOUD_BASE_URL=https://your-site.atlassian.net
# Base64-encoded "email:api_token"  (echo -n "you@example.com:ATATT..." | base64)
CLOUD_API_TOKEN=

# Jira Data Center (source; used only to resolve DC filter IDs to names)
DC_BASE_URL=https://jira-dc.example.com
DC_USERNAME=
DC_PASSWORD=

# Cloud Assets workspace UUID — required only for --asset-live-fallback.
# Use the same value as in sync_asset_ticket_associations/.env.
CLOUD_WORKSPACE_ID=
