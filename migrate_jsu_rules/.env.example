# Jira Data Center (source) - supports either PAT Bearer or Basic auth.
# Pick ONE style.
DC_BASE_URL=https://jira-dc.example.com

# Option A: PAT (preferred on modern DC)
DC_AUTH_TYPE=bearer
DC_PAT=your-personal-access-token

# Option B: Basic (username + password)
# DC_AUTH_TYPE=basic
# DC_USERNAME=your.username
# DC_PASSWORD=your-password

# Jira Cloud (target)
# CLOUD_API_TOKEN is base64(email@example.com:atlassian_api_token)
CLOUD_BASE_URL=https://your-site.atlassian.net
CLOUD_API_TOKEN=base64-email-colon-apitoken
