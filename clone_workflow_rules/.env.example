# Jira Cloud instance
# During --collect: this is the SOURCE instance (workflows are read from here)
# During --apply:   this is the TARGET instance (workflows are written here)
# For in-place JMWE fixes (--apply --update), source and target are the same.
CLOUD_BASE_URL=https://your-instance.atlassian.net

# Base64 encoding of "email@domain.com:atlassian_api_token".
# Generate with:
#   echo -n "your.email@example.com:YOUR_ATLASSIAN_API_TOKEN" | base64
CLOUD_API_TOKEN=REPLACE_WITH_BASE64_OF_EMAIL_COLON_APITOKEN
